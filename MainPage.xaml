<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur d'Âge">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom" />

            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Calculer" Command="{Binding CalculerCommand}" WidthRequest="150"/>
                <Button Text="Effacer" Command="{Binding EffacerCommand}" BackgroundColor="Gray" TextColor="White" WidthRequest="150"/>
            </HorizontalStackLayout>

            <Label Text="{Binding Resultat}" FontSize="20" IsVisible="{Binding ResultatVisible}" FontAttributes="Bold"/>
            <Label Text="{Binding StatutMajeur}" FontSize="18" IsVisible="{Binding ResultatVisible}" TextColor="DarkBlue"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>